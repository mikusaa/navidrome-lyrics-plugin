{
  "name": "Lyrics",
  "author": "Jorge Pardo",
  "version": "7.2.2",
  "description": "从多个来源获取歌词",
  "website": "https://github.com/mikusaa/navidrome-lyrics-plugin",

  "permissions": {
    "http": {
      "reason": "从互联网获取歌词；自定义地址需要访问对应主机。",
      "requiredHosts": ["*"]
    },
    "library": {
      "reason": "将歌词保存为侧车文件。",
      "filesystem": true
    },
    "cache": {
      "reason": "缓存临时状态（Apple Music 开发者令牌、商店区域和歌词源轮换位置）。"
    },
    "kvstore": {
      "reason": "持久缓存歌词，使其在重启后仍然可用。",
      "maxSize": "1000MB"
    }
  },

  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "lyricsFormats": {
          "type": "string",
          "title": "歌词格式及优先级",
          "default": "ttml,elrc,lyricsfile,lrc,srt,plain",
          "description": "按优先级排列并以英文逗号分隔。删除某种格式即可禁用（除非有明确需求，否则不建议）。可用值：lrc、elrc、ttml、srt、lyricsfile、plain。"
        },

        "instrumentalText": {
          "type": "string",
          "title": "纯音乐提示文字",
          "default": "Instrumental",
          "description": "检测到纯音乐时返回的文字。留空则不向 Navidrome 返回纯音乐歌词，也不会写入文件。"
        },

        "stripSectionLabels": {
          "type": "boolean",
          "title": "移除段落标签（如 [Verse]、[Chorus]）",
          "default": false
        },

        "durationToleranceSeconds": {
          "type": "integer",
          "title": "时长容差（秒）",
          "minimum": 1,
          "maximum": 3600,
          "default": 3,
          "description": "歌曲时长与歌词源结果之间允许的最大差值。增大此值可能降低匹配准确度。"
        },

        "providersList": {
          "type": "array",
          "title": "歌词源",
          "default": [
            { "provider": "netease" },
            { "provider": "lrclib" },
            { "provider": "lyrics.ovh" }
          ],
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "title": "歌词源",
                "default": "lrclib",
                "oneOf": [
                  { "const": "lrclib", "title": "LRCLIB" },
                  { "const": "lyrics.ovh", "title": "lyrics.ovh" },
                  { "const": "lrcmux", "title": "lrcmux" },
                  { "const": "kugou", "title": "酷狗音乐" },
                  { "const": "netease", "title": "网易云音乐（有翻译时自动双语）" },
                  { "const": "qqmusic", "title": "QQ 音乐" },
                  { "const": "applemusic", "title": "Apple Music" },
                  { "const": "stixoi", "title": "stixoi.info" }
                ]
              },
              "baseUrl": {
                "type": "string",
                "title": "自定义服务地址",
                "description": "可选。留空则使用歌词源的默认地址。"
              },
              "sources": {
                "type": "array",
                "title": "上游来源",
                "uniqueItems": true,
                "default": [
                  "genius",
                  "kugou",
                  "musixmatch",
                  "netease",
                  "ytmusic"
                ],
                "items": {
                  "type": "string",
                  "oneOf": [
                    { "const": "genius", "title": "Genius" },
                    { "const": "kugou", "title": "酷狗音乐" },
                    { "const": "musixmatch", "title": "Musixmatch" },
                    { "const": "netease", "title": "网易云音乐" },
                    { "const": "ytmusic", "title": "YouTube Music" }
                  ]
                }
              },
              "mediaUserToken": {
                "type": "string",
                "title": "媒体用户令牌",
                "description": "Apple Music 订阅用户的 media-user-token，访问歌词时必填。"
              },
              "storefront": {
                "type": "string",
                "title": "商店区域",
                "description": "可选。Apple Music 商店区域代码（如 us、gb、es）。留空时从账户自动检测，仅在自动检测不正确时填写。"
              },
              "includeTranslations": {
                "type": "boolean",
                "title": "包含翻译（是否可用取决于歌曲）",
                "default": false
              },
              "translationLanguage": {
                "type": "string",
                "title": "翻译语言",
                "default": "en-US",
                "oneOf": [
                  { "const": "ar", "title": "阿拉伯语" },
                  { "const": "ca", "title": "加泰罗尼亚语" },
                  { "const": "zh-Hans-CN", "title": "简体中文" },
                  {
                    "const": "zh-Hant-HK",
                    "title": "繁体中文（香港）"
                  },
                  {
                    "const": "zh-Hant-TW",
                    "title": "繁体中文（台湾）"
                  },
                  { "const": "hr", "title": "克罗地亚语" },
                  { "const": "cs", "title": "捷克语" },
                  { "const": "da", "title": "丹麦语" },
                  { "const": "nl", "title": "荷兰语" },
                  { "const": "en-AU", "title": "英语（澳大利亚）" },
                  { "const": "en-CA", "title": "英语（加拿大）" },
                  { "const": "en-GB", "title": "英语（英国）" },
                  { "const": "en-US", "title": "英语（美国）" },
                  { "const": "fi", "title": "芬兰语" },
                  { "const": "fr-FR", "title": "法语" },
                  { "const": "fr-CA", "title": "法语（加拿大）" },
                  { "const": "de-DE", "title": "德语" },
                  { "const": "de-CH", "title": "德语（瑞士）" },
                  { "const": "el", "title": "希腊语" },
                  { "const": "he", "title": "希伯来语" },
                  { "const": "hi", "title": "印地语" },
                  { "const": "hu", "title": "匈牙利语" },
                  { "const": "id", "title": "印度尼西亚语" },
                  { "const": "it", "title": "意大利语" },
                  { "const": "ja", "title": "日语" },
                  { "const": "ko", "title": "韩语" },
                  { "const": "ms", "title": "马来语" },
                  { "const": "nb", "title": "挪威博克马尔语" },
                  { "const": "pl", "title": "波兰语" },
                  { "const": "pt-BR", "title": "葡萄牙语（巴西）" },
                  { "const": "pt-PT", "title": "葡萄牙语（葡萄牙）" },
                  { "const": "ro", "title": "罗马尼亚语" },
                  { "const": "ru", "title": "俄语" },
                  { "const": "sk", "title": "斯洛伐克语" },
                  { "const": "es-MX", "title": "西班牙语（墨西哥）" },
                  { "const": "es-ES", "title": "西班牙语（西班牙）" },
                  { "const": "sv", "title": "瑞典语" },
                  { "const": "th", "title": "泰语" },
                  { "const": "tr", "title": "土耳其语" },
                  { "const": "uk", "title": "乌克兰语" },
                  { "const": "vi", "title": "越南语" }
                ],
                "description": "译文使用的语言，仅在包含翻译时生效。"
              },
              "includeRomanization": {
                "type": "boolean",
                "title": "包含罗马音（是否可用取决于歌曲）",
                "default": false
              }
            },
            "required": ["provider"],
            "allOf": [
              {
                "if": {
                  "properties": { "provider": { "const": "applemusic" } },
                  "required": ["provider"]
                },
                "then": { "required": ["mediaUserToken"] }
              }
            ]
          }
        },

        "providerMode": {
          "type": "string",
          "title": "歌词源模式",
          "default": "priority",
          "oneOf": [
            { "const": "priority", "title": "按顺序优先" },
            { "const": "rotation", "title": "轮换" },
            { "const": "type", "title": "格式优先" },
            { "const": "sync", "title": "最佳同步级别" }
          ]
        },

        "preferUncensored": {
          "type": "boolean",
          "title": "优先未删减歌词",
          "default": false
        },

        "enableCache": {
          "type": "boolean",
          "title": "启用歌词缓存",
          "default": true
        },

        "perTypeCacheTtl": {
          "type": "boolean",
          "title": "按歌词格式分别设置缓存有效期",
          "default": false
        },

        "cacheTtlHours": {
          "type": "integer",
          "title": "缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "歌词缓存的有效时长，默认为 7 天。"
        },

        "ttmlCacheTtlHours": {
          "type": "integer",
          "title": "TTML 缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "默认为 14 天。"
        },

        "lyricsfileCacheTtlHours": {
          "type": "integer",
          "title": "Lyricsfile 缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "默认为 7 天。"
        },

        "elrcCacheTtlHours": {
          "type": "integer",
          "title": "ELRC 缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "默认为 14 天。"
        },

        "lrcCacheTtlHours": {
          "type": "integer",
          "title": "LRC 缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "默认为 7 天。"
        },

        "srtCacheTtlHours": {
          "type": "integer",
          "title": "SRT 缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 168,
          "description": "默认为 7 天。"
        },

        "plainCacheTtlHours": {
          "type": "integer",
          "title": "纯文本缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 72,
          "description": "默认为 3 天。"
        },

        "instrumentalCacheTtlHours": {
          "type": "integer",
          "title": "纯音乐缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 336,
          "description": "默认为 14 天。"
        },

        "negativeCache": {
          "type": "boolean",
          "title": "缓存未找到歌词的结果（按歌词源）",
          "default": true
        },

        "negativeCacheTtlHours": {
          "type": "integer",
          "title": "未找到结果的缓存有效期（小时）",
          "minimum": 1,
          "maximum": 1000000,
          "default": 24,
          "description": "每个歌词源未找到结果时的缓存有效时长，默认为 24 小时。"
        },

        "writeLyrics": {
          "type": "boolean",
          "title": "将歌词写入文件",
          "default": false
        },

        "plainExtension": {
          "type": "string",
          "title": "纯文本歌词扩展名",
          "default": "txt",
          "description": "纯文本歌词文件的扩展名。LRC、ELRC、TTML、SRT 和 YAML 始终使用各自的标准扩展名。"
        },

        "instrumentalExtension": {
          "type": "string",
          "title": "纯音乐歌词扩展名",
          "default": "txt",
          "description": "纯音乐提示文件使用的扩展名。"
        },

        "overwriteLyrics": {
          "type": "boolean",
          "title": "覆盖已有歌词文件",
          "default": false
        },

        "writeToSpecificFolder": {
          "type": "boolean",
          "title": "写入自定义路径，而不是歌曲文件旁边",
          "default": false
        },

        "writeToSpecificFolderLibraryId": {
          "type": "integer",
          "title": "媒体库 ID",
          "minimum": 0,
          "description": "选择一个媒体库，并以其根目录作为输出路径的起点。填写 Navidrome 中显示的数字 ID。"
        },

        "writeToSpecificFolderTemplate": {
          "type": "string",
          "title": "输出路径模板",
          "default": "_lyrics/{type}/{track:album_artist} - {track:album}/{track:disc_number:2} - {track:track_number:2} {track:title}",
          "description": "相对于所选媒体库根目录的路径，支持模板变量。完整变量列表请查看 GitHub。"
        }
      },
      "required": ["providerMode"],
      "if": {
        "properties": {
          "writeToSpecificFolder": { "const": true }
        },
        "required": ["writeToSpecificFolder"]
      },
      "then": {
        "required": ["writeToSpecificFolderLibraryId"]
      }
    },

    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "歌词",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/lyricsFormats"
            },
            {
              "type": "Control",
              "scope": "#/properties/durationToleranceSeconds"
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalText"
            },
            {
              "type": "Control",
              "scope": "#/properties/stripSectionLabels"
            }
          ]
        },

        {
          "type": "Group",
          "label": "歌词源",
          "elements": [
            {
              "type": "Label",
              "text": "按列表配置要查询的歌词源。同一歌词源可以使用不同参数添加多次（例如同时添加使用自定义地址和默认地址的 LRCLIB）。下方的歌词源模式决定每次查询如何使用此列表。网易云音乐有翻译时会自动返回双语歌词。"
            },
            {
              "type": "Control",
              "scope": "#/properties/providerMode"
            },
            {
              "type": "Label",
              "text": "• 按顺序优先：每次从上到下查询，使用第一个返回歌词的来源。"
            },
            {
              "type": "Label",
              "text": "• 轮换：每次从列表中的下一个歌词源开始，依次循环；首选来源无结果时再查询其余来源。适合分散请求并减少限流。"
            },
            {
              "type": "Label",
              "text": "• 格式优先：继续查询，直到取得各歌词源能够提供的最高优先级格式；无法优于现有结果的来源会被跳过，同级时使用列表中更靠前的来源。每次查询会产生更多请求。"
            },
            {
              "type": "Label",
              "text": "• 最佳同步级别：与格式优先类似，但按同步精度排序（逐字 > 逐行 > 纯文本）。每次查询会产生更多请求。"
            },
            {
              "type": "Control",
              "scope": "#/properties/preferUncensored",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/providerMode",
                  "schema": {
                    "enum": ["type", "sync"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/providersList",
              "options": {
                "showSortButtons": true,
                "elementLabelProp": "provider",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/baseUrl",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "enum": ["lrclib", "lyrics.ovh", "lrcmux"]
                          }
                        }
                      }
                    },
                    {
                      "type": "Label",
                      "text": "上游来源",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "lrcmux"
                          }
                        }
                      }
                    },
                    {
                      "type": "VerticalLayout",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "lrcmux"
                          }
                        }
                      },
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/sources",
                          "label": false
                        }
                      ]
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/mediaUserToken",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/storefront",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/includeRomanization",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/includeTranslations",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/provider",
                          "schema": {
                            "const": "applemusic"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/translationLanguage",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/includeTranslations",
                          "schema": {
                            "const": true
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },

        {
          "type": "Group",
          "label": "缓存",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/enableCache"
            },
            {
              "type": "Control",
              "scope": "#/properties/cacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": false
                      }
                    },
                    "required": ["enableCache"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/ttmlCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/lyricsfileCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/elrcCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/lrcCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/srtCacheTtlHours"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/plainCacheTtlHours"
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/instrumentalCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "perTypeCacheTtl": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "perTypeCacheTtl"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCache",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/negativeCacheTtlHours",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#",
                  "schema": {
                    "properties": {
                      "enableCache": {
                        "const": true
                      },
                      "negativeCache": {
                        "const": true
                      }
                    },
                    "required": ["enableCache", "negativeCache"]
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/perTypeCacheTtl",
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/enableCache",
                  "schema": {
                    "const": true
                  }
                }
              }
            }
          ]
        },

        {
